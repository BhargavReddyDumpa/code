<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>MMVG Health Care</title>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet"/>
  <style>
    :root {
      --teal: #0a7c6e;
      --teal-light: #12a08f;
      --teal-pale: #e6f5f3;
      --navy: #0d2b3e;
      --white: #ffffff;
      --gray: #f4f7f6;
      --text: #2c3e35;
      --muted: #6b7f78;
      --accent: #e8f4f1;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    html { scroll-behavior: smooth; }

    body {
      font-family: 'DM Sans', sans-serif;
      color: var(--text);
      background: var(--white);
      overflow-x: hidden;
    }

    /* ── TOP BAR ── */
    .topbar {
      background: var(--navy);
      color: #aac4d0;
      font-size: 0.82rem;
      padding: 0.5rem 2rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .topbar a { color: #aac4d0; text-decoration: none; margin-left: 1.5rem; }
    .topbar a:hover { color: #fff; }
    .topbar-left { display: flex; gap: 1.5rem; }

    /* ── NAVBAR ── */
    nav {
      background: var(--white);
      padding: 1rem 2rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: sticky;
      top: 0;
      z-index: 100;
      box-shadow: 0 2px 20px rgba(0,0,0,0.07);
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      text-decoration: none;
    }

    .logo-icon {
      width: 44px;
      height: 44px;
      background: var(--teal);
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-size: 1.3rem;
    }

    .logo-text { line-height: 1.2; }
    .logo-text strong {
      display: block;
      font-family: 'Playfair Display', serif;
      font-size: 1.2rem;
      color: var(--navy);
    }
    .logo-text span { font-size: 0.72rem; color: var(--muted); letter-spacing: 0.05em; }

    .nav-links {
      list-style: none;
      display: flex;
      gap: 0.25rem;
      align-items: center;
    }

    .nav-links a {
      color: var(--text);
      text-decoration: none;
      font-size: 0.9rem;
      font-weight: 500;
      padding: 0.5rem 0.9rem;
      border-radius: 6px;
      transition: all 0.2s;
    }

    .nav-links a:hover { background: var(--teal-pale); color: var(--teal); }

    .nav-cta {
      background: var(--teal) !important;
      color: white !important;
      border-radius: 8px !important;
      padding: 0.6rem 1.2rem !important;
    }

    .nav-cta:hover { background: var(--teal-light) !important; }

    .hamburger { display: none; flex-direction: column; gap: 5px; cursor: pointer; }
    .hamburger span { width: 24px; height: 2.5px; background: var(--navy); border-radius: 2px; }

    /* ── HERO ── */
    .hero {
      background: linear-gradient(110deg, var(--navy) 55%, var(--teal) 100%);
      padding: 5rem 2rem 4rem;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
      align-items: center;
      max-width: 1200px;
      margin: 0 auto;
    }

    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: rgba(255,255,255,0.1);
      border: 1px solid rgba(255,255,255,0.2);
      color: #7dd8cc;
      font-size: 0.8rem;
      padding: 0.35rem 0.9rem;
      border-radius: 30px;
      margin-bottom: 1.5rem;
      letter-spacing: 0.04em;
    }

    .hero h1 {
      font-family: 'Playfair Display', serif;
      font-size: clamp(2rem, 4vw, 3rem);
      color: white;
      line-height: 1.25;
      margin-bottom: 1.25rem;
    }

    .hero h1 em { color: #7dd8cc; font-style: normal; }

    .hero p {
      color: #aac4d0;
      font-size: 1.05rem;
      line-height: 1.7;
      margin-bottom: 2rem;
      max-width: 480px;
    }

    .hero-btns { display: flex; gap: 1rem; flex-wrap: wrap; }

    .btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.8rem 1.8rem;
      border-radius: 8px;
      text-decoration: none;
      font-weight: 600;
      font-size: 0.95rem;
      transition: all 0.25s;
      border: none;
      cursor: pointer;
    }

    .btn-white { background: white; color: var(--teal); }
    .btn-white:hover { background: #e6f5f3; transform: translateY(-2px); }

    .btn-outline-white {
      background: transparent;
      color: white;
      border: 1.5px solid rgba(255,255,255,0.4);
    }

    .btn-outline-white:hover { border-color: white; background: rgba(255,255,255,0.08); }

    .btn-teal { background: var(--teal); color: white; }
    .btn-teal:hover { background: var(--teal-light); transform: translateY(-2px); }

    .hero-image {
      position: relative;
      display: flex;
      justify-content: center;
    }

    .hero-card {
      background: white;
      border-radius: 20px;
      padding: 2rem;
      width: 100%;
      max-width: 380px;
      box-shadow: 0 30px 60px rgba(0,0,0,0.3);
    }

    .hero-card-header {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-bottom: 1.5rem;
      padding-bottom: 1.25rem;
      border-bottom: 1px solid #eee;
    }

    .doctor-avatar {
      width: 56px;
      height: 56px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--teal), var(--navy));
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
    }

    .doctor-info strong { display: block; color: var(--navy); font-size: 0.95rem; }
    .doctor-info span { color: var(--muted); font-size: 0.82rem; }

    .stat-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
      margin-bottom: 1.25rem;
    }

    .stat-box {
      background: var(--gray);
      border-radius: 10px;
      padding: 1rem;
      text-align: center;
    }

    .stat-box strong {
      display: block;
      font-size: 1.4rem;
      color: var(--teal);
      font-weight: 700;
    }

    .stat-box span { font-size: 0.78rem; color: var(--muted); }

    .appointment-btn {
      width: 100%;
      background: var(--teal);
      color: white;
      border: none;
      padding: 0.85rem;
      border-radius: 8px;
      font-size: 0.95rem;
      font-weight: 600;
      cursor: pointer;
      font-family: inherit;
      transition: background 0.2s;
    }

    .appointment-btn:hover { background: var(--teal-light); }

    /* ── FULL-WIDTH HERO WRAP ── */
    .hero-section {
      background: linear-gradient(110deg, var(--navy) 55%, var(--teal) 100%);
    }

    /* ── SERVICES BAR ── */
    .services-bar {
      background: var(--teal);
      padding: 1.5rem 2rem;
    }

    .services-bar-inner {
      max-width: 1200px;
      margin: 0 auto;
      display: flex;
      gap: 1rem;
      justify-content: space-between;
      flex-wrap: wrap;
    }

    .service-pill {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      color: white;
      font-size: 0.88rem;
      font-weight: 500;
    }

    .service-pill span { font-size: 1.1rem; }

    /* ── SECTION COMMON ── */
    .section { padding: 5rem 2rem; }
    .section-inner { max-width: 1200px; margin: 0 auto; }

    .section-tag {
      display: inline-block;
      background: var(--teal-pale);
      color: var(--teal);
      font-size: 0.78rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      padding: 0.35rem 0.9rem;
      border-radius: 30px;
      margin-bottom: 0.75rem;
    }

    .section-title {
      font-family: 'Playfair Display', serif;
      font-size: clamp(1.7rem, 3vw, 2.4rem);
      color: var(--navy);
      line-height: 1.3;
      margin-bottom: 0.75rem;
    }

    .section-sub { color: var(--muted); font-size: 1rem; max-width: 560px; line-height: 1.7; }

    /* ── SERVICES ── */
    .services { background: var(--gray); }

    .services-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
      gap: 1.5rem;
      margin-top: 3rem;
    }

    .service-card {
      background: white;
      border-radius: 16px;
      padding: 2rem 1.5rem;
      transition: all 0.3s;
      border: 1.5px solid transparent;
    }

    .service-card:hover {
      border-color: var(--teal);
      transform: translateY(-4px);
      box-shadow: 0 12px 35px rgba(10,124,110,0.12);
    }

    .service-icon {
      width: 52px;
      height: 52px;
      background: var(--teal-pale);
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
      margin-bottom: 1.25rem;
    }

    .service-card h3 { color: var(--navy); font-size: 1rem; margin-bottom: 0.5rem; }
    .service-card p { color: var(--muted); font-size: 0.88rem; line-height: 1.6; }

    /* ── WHY US ── */
    .why-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      align-items: center;
      margin-top: 3rem;
    }

    .why-image {
      background: linear-gradient(135deg, var(--teal-pale), var(--accent));
      border-radius: 20px;
      height: 420px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 7rem;
      position: relative;
      overflow: hidden;
    }

    .why-image::before {
      content: '';
      position: absolute;
      width: 200px;
      height: 200px;
      background: rgba(10,124,110,0.08);
      border-radius: 50%;
      top: -40px;
      right: -40px;
    }

    .why-list { list-style: none; display: flex; flex-direction: column; gap: 1.25rem; }

    .why-item {
      display: flex;
      gap: 1rem;
      align-items: flex-start;
    }

    .why-check {
      width: 36px;
      height: 36px;
      min-width: 36px;
      background: var(--teal-pale);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--teal);
      font-size: 1rem;
      margin-top: 2px;
    }

    .why-item h4 { color: var(--navy); font-size: 0.95rem; margin-bottom: 0.2rem; }
    .why-item p { color: var(--muted); font-size: 0.87rem; line-height: 1.5; }

    /* ── DOCTORS ── */
    .doctors { background: var(--gray); }

    .doctors-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 1.5rem;
      margin-top: 3rem;
    }

    .doctor-card {
      background: white;
      border-radius: 16px;
      overflow: hidden;
      transition: transform 0.3s, box-shadow 0.3s;
    }

    .doctor-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 16px 40px rgba(0,0,0,0.1);
    }

    .doctor-photo {
      height: 180px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 4rem;
    }

    .d1 { background: linear-gradient(135deg, #d4eee9, #a8ddd6); }
    .d2 { background: linear-gradient(135deg, #d0e4f0, #a0c8e0); }
    .d3 { background: linear-gradient(135deg, #dde4d4, #bdd0a8); }
    .d4 { background: linear-gradient(135deg, #e8d8e8, #d0aad0); }

    .doctor-info-card { padding: 1.25rem; }
    .doctor-info-card h3 { color: var(--navy); font-size: 0.95rem; font-weight: 600; }
    .doctor-info-card .specialty { color: var(--teal); font-size: 0.82rem; font-weight: 500; margin: 0.2rem 0 0.6rem; }
    .doctor-info-card .rating { color: var(--muted); font-size: 0.8rem; }

    /* ── STATS ── */
    .stats-section {
      background: var(--navy);
      padding: 4rem 2rem;
    }

    .stats-grid {
      max-width: 1000px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 2rem;
      text-align: center;
    }

    .stat-item strong {
      display: block;
      font-family: 'Playfair Display', serif;
      font-size: 2.5rem;
      color: #7dd8cc;
      line-height: 1;
      margin-bottom: 0.4rem;
    }

    .stat-item span { color: #aac4d0; font-size: 0.88rem; }

    /* ── TESTIMONIALS ── */
    .testimonials-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 1.5rem;
      margin-top: 3rem;
    }

    .testimonial-card {
      background: var(--gray);
      border-radius: 16px;
      padding: 1.75rem;
      border-left: 4px solid var(--teal);
    }

    .testimonial-card p {
      color: var(--text);
      font-size: 0.92rem;
      line-height: 1.7;
      margin-bottom: 1.25rem;
      font-style: italic;
    }

    .testimonial-author { display: flex; align-items: center; gap: 0.75rem; }

    .author-avatar {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: var(--teal);
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-weight: 700;
      font-size: 0.85rem;
    }

    .author-info strong { display: block; font-size: 0.88rem; color: var(--navy); }
    .author-info span { font-size: 0.78rem; color: var(--muted); }
    .stars { color: #f5a623; font-size: 0.85rem; margin-top: 0.2rem; }

    /* ── APPOINTMENT ── */
    .appointment-section {
      background: linear-gradient(135deg, var(--teal), var(--navy));
      padding: 5rem 2rem;
      text-align: center;
    }

    .appointment-section h2 {
      font-family: 'Playfair Display', serif;
      color: white;
      font-size: clamp(1.8rem, 3vw, 2.5rem);
      margin-bottom: 1rem;
    }

    .appointment-section p { color: #aac4d0; margin-bottom: 2rem; font-size: 1rem; }

    .appt-form {
      display: flex;
      gap: 1rem;
      max-width: 700px;
      margin: 0 auto;
      flex-wrap: wrap;
      justify-content: center;
    }

    .appt-form input, .appt-form select {
      flex: 1;
      min-width: 180px;
      padding: 0.8rem 1.1rem;
      border-radius: 8px;
      border: none;
      font-size: 0.9rem;
      font-family: inherit;
      background: rgba(255,255,255,0.95);
      color: var(--text);
    }

    .appt-form input:focus, .appt-form select:focus { outline: 2px solid #7dd8cc; }

    /* ── CONTACT INFO ── */
    .contact-bar {
      background: var(--navy);
      padding: 2rem;
    }

    .contact-bar-inner {
      max-width: 1200px;
      margin: 0 auto;
      display: flex;
      justify-content: space-around;
      flex-wrap: wrap;
      gap: 1.5rem;
    }

    .contact-item {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      color: #aac4d0;
    }

    .contact-item-icon {
      width: 40px;
      height: 40px;
      background: rgba(255,255,255,0.08);
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.1rem;
    }

    .contact-item strong { display: block; color: white; font-size: 0.88rem; }
    .contact-item span { font-size: 0.8rem; }

    /* ── FOOTER ── */
    footer {
      background: #060f16;
      color: #6b8a99;
      padding: 3rem 2rem 1.5rem;
    }

    .footer-grid {
      max-width: 1200px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 2fr 1fr 1fr 1fr;
      gap: 3rem;
      margin-bottom: 2.5rem;
    }

    .footer-brand p { font-size: 0.88rem; line-height: 1.7; margin-top: 0.75rem; max-width: 260px; }

    footer h4 { color: white; font-size: 0.9rem; margin-bottom: 1rem; }

    .footer-links { list-style: none; display: flex; flex-direction: column; gap: 0.6rem; }
    .footer-links a { color: #6b8a99; text-decoration: none; font-size: 0.85rem; transition: color 0.2s; }
    .footer-links a:hover { color: #7dd8cc; }

    .footer-bottom {
      max-width: 1200px;
      margin: 0 auto;
      border-top: 1px solid #1a2e3d;
      padding-top: 1.5rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.82rem;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    /* ── RESPONSIVE ── */
    @media (max-width: 900px) {
      .hero { grid-template-columns: 1fr; text-align: center; }
      .hero p { margin: 0 auto 2rem; }
      .hero-btns { justify-content: center; }
      .hero-image { display: none; }
      .why-grid { grid-template-columns: 1fr; }
      .why-image { height: 220px; }
      .stats-grid { grid-template-columns: repeat(2, 1fr); }
      .footer-grid { grid-template-columns: 1fr 1fr; }
    }

    @media (max-width: 600px) {
      .topbar { justify-content: center; text-align: center; }
      .nav-links { display: none; flex-direction: column; position: absolute; top: 70px; left: 0; right: 0; background: white; padding: 1.5rem 2rem; box-shadow: 0 8px 20px rgba(0,0,0,0.1); }
      .nav-links.open { display: flex; }
      .hamburger { display: flex; }
      .stats-grid { grid-template-columns: repeat(2, 1fr); }
      .footer-grid { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>

  <!-- TOP BAR -->
  <div class="topbar">
    <div class="topbar-left">
      <span>📞 Emergency: 1-800-MMVG-911</span>
      <span>🕐 Mon–Sat: 8:00 AM – 6:00 PM</span>
    </div>
    <div>
      <a href="#">Patient Portal</a>
      <a href="#">Pay Bill</a>
      <a href="#">Careers</a>
    </div>
  </div>

  <!-- NAVBAR -->
  <nav>
    <a href="#" class="logo">
      <div class="logo-icon">⚕️</div>
      <div class="logo-text">
        <strong>MMVG Health Care</strong>
        <span>Compassionate Care · Advanced Medicine</span>
      </div>
    </a>
    <ul class="nav-links" id="navLinks">
      <li><a href="#services">Services</a></li>
      <li><a href="#doctors">Our Doctors</a></li>
      <li><a href="#about">About Us</a></li>
      <li><a href="#testimonials">Reviews</a></li>
      <li><a href="#appointment" class="nav-cta">Book Appointment</a></li>
    </ul>
    <div class="hamburger" onclick="document.getElementById('navLinks').classList.toggle('open')">
      <span></span><span></span><span></span>
    </div>
  </nav>

  <!-- HERO -->
  <div class="hero-section">
    <div class="hero">
      <div class="hero-content">
        <div class="hero-badge">⭐ Trusted by 50,000+ Patients</div>
        <h1>Your Health Is Our <em>Greatest Priority</em></h1>
        <p>MMVG Health Care provides world-class medical services with compassionate, patient-centered care. From routine checkups to advanced treatments — we're here for you.</p>
        <div class="hero-btns">
          <a href="#appointment" class="btn btn-white">📅 Book Appointment</a>
          <a href="#services" class="btn btn-outline-white">Our Services →</a>
        </div>
      </div>
      <div class="hero-image">
        <div class="hero-card">
          <div class="hero-card-header">
            <div class="doctor-avatar">👨‍⚕️</div>
            <div class="doctor-info">
              <strong>Dr. Reddy, MD</strong>
              <span>Chief Medical Officer</span>
            </div>
          </div>
          <div class="stat-row">
            <div class="stat-box">
              <strong>15+</strong>
              <span>Years Experience</span>
            </div>
            <div class="stat-box">
              <strong>98%</strong>
              <span>Patient Satisfaction</span>
            </div>
          </div>
          <div class="stat-row">
            <div class="stat-box">
              <strong>50K+</strong>
              <span>Patients Treated</span>
            </div>
            <div class="stat-box">
              <strong>24/7</strong>
              <span>Emergency Care</span>
            </div>
          </div>
          <button class="appointment-btn">📅 Schedule a Visit</button>
        </div>
      </div>
    </div>
  </div>

  <!-- SERVICES BAR -->
  <div class="services-bar">
    <div class="services-bar-inner">
      <div class="service-pill"><span>🏥</span> Primary Care</div>
      <div class="service-pill"><span>🫀</span> Cardiology</div>
      <div class="service-pill"><span>🧠</span> Neurology</div>
      <div class="service-pill"><span>🦷</span> Dental Care</div>
      <div class="service-pill"><span>👁️</span> Ophthalmology</div>
      <div class="service-pill"><span>🤱</span> Pediatrics</div>
      <div class="service-pill"><span>🩻</span> Radiology</div>
    </div>
  </div>

  <!-- SERVICES -->
  <section class="section services" id="services">
    <div class="section-inner">
      <div class="section-tag">Our Services</div>
      <h2 class="section-title">Comprehensive Medical Care<br>Under One Roof</h2>
      <p class="section-sub">We offer a full range of medical services using the latest technology and evidence-based practices.</p>
      <div class="services-grid">
        <div class="service-card">
          <div class="service-icon">🫀</div>
          <h3>Cardiology</h3>
          <p>Advanced heart care including ECG, echocardiography, stress testing, and cardiac rehabilitation.</p>
